# Copy this file to .env and fill in values before running

# Server port
PORT=3001

# CORS origin — set to the exact URL the frontend will be served from.
# Development:  http://localhost:5173
# Production event (example): http://192.168.1.10:5173
CORS_ORIGIN=http://localhost:5173

# Optional: override database and upload paths (defaults are fine for most setups)
DATABASE_PATH=
UPLOAD_DIR=
